{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "generated/**/*.ts",
    "express.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "neon.ts",
    "prisma7.config.ts"
  ]
}
