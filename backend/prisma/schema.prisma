generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
}

model Product {
    id              Int         @id @default(autoincrement())
    name            String      @unique
    slug            String      @unique
    hotSeller       Boolean     @default(false)
    category        String
    description     String
    variants        Variant[]
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
}

model Variant {
     id         Int     @id @default(autoincrement())
    label       String  @unique
    sku         String  @unique
    stock       Int
    price       Int
    onSale      Boolean @default(false)
    salePrice   Int?
    images      String[]
    productId   Int
    product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id      Int   @id @default(autoincrement())
  name    String
  rating  Int
  title   String
  comment String
}